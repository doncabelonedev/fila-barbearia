    {
      "parameters": {
        "jsCode": "// WhatsApp usa *negrito* (asterisco simples) e _itálico_, mas o admin digita\n// no padrão Markdown (**negrito**, *itálico*). Converte antes de enviar,\n// senão o cliente recebe os asteriscos literais no WhatsApp.\nconst raw = String($input.first().json.mensagem_texto || '');\nconst BOLD_MARK = '\\u0000';\n\nlet formatted = raw.replace(/\\*\\*(.+?)\\*\\*/g, (_, t) => `${BOLD_MARK}${t}${BOLD_MARK}`);\nformatted = formatted.replace(/\\*(.+?)\\*/g, '_$1_');\nformatted = formatted.split(BOLD_MARK).join('*');\n\nreturn [{\n  json: {\n    ...$input.first().json,\n    mensagem_formatada: formatted\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1120,
        800
      ],
      "id": "048a65cd-caab-4192-82e9-e88faa6a9b71",
      "name": "Formatar Mensagem WhatsApp"
