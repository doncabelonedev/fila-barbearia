              "field": "minutes"
            }
          ]
        }
      },
      "id": "147a5b8b-10df-4d12-b8a5-6df3cb729acc",
      "name": "Schedule 5min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -688,
        384
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH s AS (\n  SELECT manual_status, is_lunch_paused, is_pre_opening,\n         whatsapp_number, shop_name, tracking_url_base\n  FROM public.shop_settings\n  LIMIT 1\n),\nsched AS (\n  SELECT\n    COALESCE(se.is_closed, bs.is_closed) AS is_closed,\n    COALESCE(se.open_time, bs.open_time) AS open_time,\n    COALESCE(se.close_time, bs.close_time) AS close_time\n  FROM public.barbershop_schedule bs\n  LEFT JOIN public.schedule_exceptions se ON se.date = CURRENT_DATE\n  WHERE bs.weekday = EXTRACT(DOW FROM CURRENT_DATE)::int\n),\nshop_state AS (\n  SELECT COALESCE(\n    (SELECT\n      CASE\n        WHEN is_closed = true THEN false\n        WHEN open_time IS NULL OR close_time IS NULL THEN true\n        WHEN (now() AT TIME ZONE 'America/Sao_Paulo')::time\n             BETWEEN open_time AND close_time THEN true\n        ELSE false\n      END\n     FROM sched),\n    true\n  ) AS is_open\n),\nq AS (\n  SELECT\n    (SELECT COUNT(*) FROM public.queue WHERE status = 'serving') AS serving_count,\n    (SELECT COUNT(*) FROM public.queue WHERE status = 'waiting') AS waiting_count,\n    (SELECT COUNT(*) FROM public.queue\n       WHERE status = 'waiting' AND created_at <= now() - interval '5 minutes') AS waiting_5min_count,\n    (SELECT to_char(MIN(created_at), 'HH24:MI') FROM public.queue\n       WHERE status = 'waiting') AS oldest_waiting_at\n)\nSELECT s.manual_status, s.is_lunch_paused, s.is_pre_opening,\n       s.whatsapp_number, s.shop_name, s.tracking_url_base,\n       q.serving_count, q.waiting_count, q.waiting_5min_count, q.oldest_waiting_at,\n       sh.is_open\nFROM s CROSS JOIN q CROSS JOIN shop_state sh;",
        "options": {}
      },
      "id": "1d4cf1b2-82fb-4d8d-8a8c-d1505d879c5d",
      "name": "Query Shop + Queue",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -464,
        384
      ],
      "credentials": {
        "postgres": {
          "id": "uEJcXBMdzMROjoRJ",
          "name": "filabarbearia - conta wagner producao"
        }
      }
    },
