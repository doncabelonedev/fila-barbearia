            {
              "id": "a1-text",
              "name": "text",
              "value": "={{ '⚠️ *Alerta de Atraso — ' + $json.shop_name + '*\\n\\nHá um atendimento em atraso.\\n\\nCliente *' + ($json.customer_name || 'Cliente') + '* (' + $json.code + ') está em atendimento há *' + $json.elapsed_min + 'min*, mas o serviço planejado era de *' + $json.service_duration + 'min* (atraso de *' + $json.overtime_min + 'min*).\\n\\nAcesse o painel: ' + $json.tracking_url_base + 'admin' }}",
              "type": "string"
            }
