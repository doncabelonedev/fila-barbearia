{
  "name": "Barber Alert — Overtime (5min cron)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes"
            }
          ]
        }
      },
      "id": "1288e3ef-13b1-45ef-9968-22d5cd5ce0e7",
      "name": "Schedule 5min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [736, -176]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH s AS (\n  SELECT shop_name, tracking_url_base\n  FROM public.shop_settings\n  LIMIT 1\n),\novertime_data AS (\n  SELECT\n    q.code,\n    q.service_duration,\n    EXTRACT(EPOCH FROM (now() - q.service_start))::int / 60 AS elapsed_min,\n    (EXTRACT(EPOCH FROM (now() - q.service_start))::int / 60) - q.service_duration AS overtime_min,\n    c.name AS customer_name\n  FROM public.queue q\n  LEFT JOIN public.customers c ON c.id = q.customer_id\n  WHERE q.status = 'serving'\n    AND q.service_start IS NOT NULL\n    AND q.service_duration IS NOT NULL\n    AND q.service_duration > 0\n    AND (now() - q.service_start) > make_interval(mins => q.service_duration)\n  LIMIT 1\n)\nSELECT\n  s.shop_name,\n  s.tracking_url_base,\n  EXISTS (SELECT 1 FROM overtime_data) AS has_overtime,\n  od.code,\n  od.service_duration,\n  od.elapsed_min,\n  od.overtime_min,\n  od.customer_name\nFROM s\nLEFT JOIN overtime_data od ON true;",
        "options": {}
      },
      "id": "6fab8633-119c-455f-84f5-d47afa38cacd",
      "name": "Query Overtime Serving",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [960, -176],
      "credentials": {
        "postgres": {
          "id": "uMvoklfk8laQ7yLw",
          "name": "doncabelone des - olaszlucas"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1-hasovertime",
              "leftValue": "={{ $json.has_overtime }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "abd6d82a-f589-4c86-a89a-cadac7230672",
      "name": "Has Overtime?",
