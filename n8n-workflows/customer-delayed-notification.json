{
  "name": "Customer Delayed Notification (1min cron)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes"
            }
          ]
        }
      },
      "id": "25a7c1d4-8e32-4f9a-b6c1-7d3a9f5e2b10",
      "name": "Schedule 1min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-960, 400]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  is_lunch_paused,\n  is_pre_opening,\n  manual_status,\n  tracking_url_base,\n  COALESCE(base_queue_time, 30) AS base_queue_time,\n  EXISTS(\n    SELECT 1 FROM public.queue\n    WHERE status = 'serving'\n      AND service_start IS NOT NULL\n      AND EXTRACT(EPOCH FROM now()) - EXTRACT(EPOCH FROM service_start) > COALESCE(service_duration, 30) * 60\n  ) AS has_overtime\nFROM public.shop_settings\nLIMIT 1",
        "options": {}
      },
      "id": "c8d2f4a7-3e19-4b6c-9d5f-1a8c7b3e6f42",
      "name": "Check Conditions",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-720, 400],
      "credentials": {
        "postgres": {
          "id": "uMvoklfk8laQ7yLw",
          "name": "doncabelone des - olaszlucas"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1-auto",
              "leftValue": "={{ $json.manual_status }}",
              "rightValue": "auto",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "c2-lunch",
              "leftValue": "={{ $json.is_lunch_paused }}",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            },
            {
              "id": "c3-pre",
              "leftValue": "={{ $json.is_pre_opening }}",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            },
            {
              "id": "c4-overtime",
              "leftValue": "={{ $json.has_overtime }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "d9f3a6b2-1c54-4e87-9d23-8f1c4e7a3b56",
      "name": "Should Run?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-480, 400]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE public.queue\nSET service_duration = GREATEST(\n  COALESCE(service_duration, 30),\n  EXTRACT(EPOCH FROM (now() - service_start))::int / 60 + 10\n)\nWHERE status = 'serving'\n  AND service_start IS NOT NULL",
        "options": {}
      },
      "id": "b1e5c7a3-9d4f-4b2e-8c1d-6a9f3e7b5c21",
      "name": "Update Serving Duration",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-360, 400],
      "credentials": {
        "postgres": {
          "id": "uMvoklfk8laQ7yLw",
          "name": "doncabelone des - olaszlucas"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  q.id AS queue_id,\n  q.code,\n  c.name AS customer_name,\n  c.phone,\n  ROW_NUMBER() OVER (ORDER BY q.position) AS waiting_index,\n  (SELECT tracking_url_base FROM public.shop_settings LIMIT 1) AS tracking_url_base,\n  COALESCE((SELECT base_queue_time FROM public.shop_settings LIMIT 1), 30) AS base_queue_time\nFROM public.queue q\nJOIN public.customers c ON c.id = q.customer_id\nWHERE q.status = 'waiting'\n  AND c.phone NOT LIKE 'manual_%'\n  AND (\n    q.last_delay_sent_at IS NULL\n    OR EXTRACT(EPOCH FROM now()) - EXTRACT(EPOCH FROM q.last_delay_sent_at) > 600\n  )\nORDER BY q.position",
        "options": {}
      },
      "id": "4a7e2c9f-8b31-4d5e-a1f6-3c9d7b2e8a14",
      "name": "Fetch Waiting Customers",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-240, 400],
      "credentials": {
        "postgres": {
          "id": "uMvoklfk8laQ7yLw",
          "name": "doncabelone des - olaszlucas"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1-queue-id",
              "name": "queue_id",
              "value": "={{ $json.queue_id }}",
              "type": "string"
            },
            {
              "id": "a2-chat-id",
              "name": "chatId",
              "value": "={{ $json.phone.replace(/\\D/g, '') + '@c.us' }}",
              "type": "string"
            },
            {
              "id": "a3-position",
              "name": "position",
              "value": "={{ $json.waiting_index + 1 }}",
              "type": "number"
            },
            {
              "id": "a4-text",
              "name": "text",
              "value": "={{ '⚠️ *O barbeiro está um pouco atrasado!*\\n\\nOlá ' + $json.customer_name + ', o atendimento atual está levando mais tempo que o previsto.\\n\\n📍 Sua posição: ' + ($json.waiting_index + 1) + 'º\\n⏱ Tempo estimado ajustado: ~' + (($json.waiting_index - 1) * ($json.base_queue_time || 30) + 10) + 'min\\n\\nAcompanhe em tempo real: ' + ($json.tracking_url_base || '') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "3f6a8d2e-9b14-4c7f-a3e5-1d6b2f4a8c90",
      "name": "Build WAHA Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [0, 400]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "7b4e8c1f-3a29-4d5b-b6f7-2e9a3c8d1f45",
      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 2,
      "position": [240, 400]
    },
    {
      "parameters": {
        "resource": "Chatting",
        "operation": "Send Text",
        "session": "=default",
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.text }}",
        "linkPreview": false,
        "requestOptions": {}
      },
      "type": "@devlikeapro/n8n-nodes-waha.WAHA",
      "typeVersion": 202502,
      "position": [480, 400],
      "id": "5c2d9f7a-4b61-4e38-a7c4-8f3d1e5b2a67",
      "name": "Send WAHA to Customer",
      "credentials": {
        "wahaApi": {
          "id": "SnPbBDMOKqjxdZQo",
          "name": "WAHA - doncabellone"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE public.queue SET last_delay_sent_at = now() WHERE id = '{{ $('Build WAHA Payload').item.json.queue_id }}'",
        "options": {}
      },
      "id": "8e1f4c6b-2d73-4a9f-b5c8-7f2a6d3e9b14",
      "name": "Update Cooldown",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [720, 400],
      "credentials": {
        "postgres": {
          "id": "uMvoklfk8laQ7yLw",
          "name": "doncabelone des - olaszlucas"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "Schedule 1min": {
      "main": [
        [
          {
            "node": "Check Conditions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Conditions": {
      "main": [
        [
          {
            "node": "Should Run?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Should Run?": {
      "main": [
        [
          {
            "node": "Update Serving Duration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Serving Duration": {
      "main": [
        [
          {
            "node": "Fetch Waiting Customers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Waiting Customers": {
      "main": [
        [
          {
            "node": "Build WAHA Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build WAHA Payload": {
      "main": [
        [
          {
            "node": "Loop Over Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Over Items": {
      "main": [
        [
          {
            "node": "Send WAHA to Customer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WAHA to Customer": {
      "main": [
        [
          {
            "node": "Update Cooldown",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate"
  },
  "versionId": "5e1a3d8b-7c29-4f6e-b9a2-1d4c8e5f3a67",
  "meta": {
    "instanceId": "d4e37845a647a12b6a7a035bf7160e477fe76eaff3797bfeee3c57876702d64d"
  },
  "id": "Gk9nM3vR7sQ2pT4w",
