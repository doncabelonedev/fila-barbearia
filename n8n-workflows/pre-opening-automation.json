    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH serving AS (\n  SELECT \n    service_start,\n    service_duration\n  FROM public.queue\n  WHERE status = 'serving'\n  LIMIT 1\n),\nnow_local AS (\n  SELECT timezone('America/Sao_Paulo', now()) AS ts\n),\nwait_times AS (\n  SELECT\n    q.id AS queue_id,\n    q.code,\n    c.name AS customer_name,\n    c.phone,\n    q.position,\n    (q.position - 1) AS people_ahead,\n    CASE\n      WHEN s.service_start IS NOT NULL THEN\n        GREATEST(\n          s.service_start + (s.service_duration || ' minutes')::interval,\n          (SELECT ts FROM now_local)\n        )\n      ELSE (SELECT ts FROM now_local)\n    END AS base_start,\n    COALESCE((\n      SELECT SUM(q2.service_duration)\n      FROM public.queue q2\n      WHERE q2.status = 'waiting' AND q2.position < q.position\n    ), 0) AS wait_minutes,\n    (SELECT tracking_url_base FROM public.shop_settings LIMIT 1) AS tracking_url_base\n  FROM public.queue q\n  JOIN public.customers c ON c.id = q.customer_id\n  LEFT JOIN serving s ON true\n  WHERE q.status = 'waiting'\n    AND c.phone NOT LIKE 'manual_%'\n)\nSELECT\n  queue_id,\n  code,\n  customer_name,\n  phone,\n  position,\n  people_ahead,\n  TO_CHAR(\n    date_trunc('hour', base_start + (wait_minutes || ' minutes')::interval) +\n    INTERVAL '1 minute' * (\n      ROUND(EXTRACT(MINUTE FROM base_start + (wait_minutes || ' minutes')::interval) / 5) * 5\n    ),\n    'HH24:MI'\n  ) AS estimated_time,\n  tracking_url_base\nFROM wait_times\nORDER BY position;",
        "options": {}
      },
