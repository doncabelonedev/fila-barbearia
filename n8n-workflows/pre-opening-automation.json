    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH settings AS (\n  SELECT \n    manual_status,\n    is_lunch_paused,\n    is_pre_opening,\n    pre_opening_minutes AS settings_pre_minutes\n  FROM public.shop_settings\n  LIMIT 1\n),\nschedule_today AS (\n  SELECT\n    COALESCE(se.is_closed, bs.is_closed) AS is_closed,\n    COALESCE(se.open_time, bs.open_time) AS open_time,\n    COALESCE(se.pre_opening_minutes, bs.pre_opening_minutes, s.settings_pre_minutes, 0) AS pre_opening_minutes\n  FROM public.barbershop_schedule bs\n  LEFT JOIN public.schedule_exceptions se ON se.date = CURRENT_DATE\n  CROSS JOIN settings s\n  WHERE bs.weekday = EXTRACT(DOW FROM CURRENT_DATE)::int\n),\nnow_br AS (\n  SELECT (now() AT TIME ZONE 'America/Sao_Paulo')::time AS current_time\n)\nSELECT\n  s.manual_status,\n  s.is_lunch_paused,\n  s.is_pre_opening,\n  st.is_closed,\n  st.open_time,\n  st.pre_opening_minutes,\n  ((EXTRACT(HOUR FROM n.current_time)::int * 60) + EXTRACT(MINUTE FROM n.current_time)::int) AS current_minutes,\n  ((EXTRACT(HOUR FROM st.open_time)::int * 60) + EXTRACT(MINUTE FROM st.open_time)::int) AS open_minutes,\n  (((EXTRACT(HOUR FROM st.open_time)::int * 60) + EXTRACT(MINUTE FROM st.open_time)::int) - st.pre_opening_minutes) AS pre_start_minutes\nFROM settings s\nCROSS JOIN schedule_today st\nCROSS JOIN now_br n;",
        "options": {}
      },
